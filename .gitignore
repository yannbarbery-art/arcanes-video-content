# Fichiers générés (vidéos, images, audio)
output/
assets-raw/
*.mp4
*.mov
*.webm
*.png
*.jpg
*.jpeg
*.wav
*.mp3
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!brand/**/*.png
!brand/**/*.jpg
!brand/**/*.jpeg

# Images de référence versionnées (dossiers refs/ des séries)
# series/**/refs/ couvre aussi series/**/characters/refs/
!series/**/refs/
!series/**/refs/**

# Secrets et configs locales
.env
.env.local
*.key
credentials/

# Tooling (scripts de génération de maps, etc.)
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp

# Divers
*.log
tmp/

# Claude Code
# .claude/cache/ et settings.local.json sont locaux/personnels.
# settings.json et les skills/commands de projet restent versionnables.
.claude/cache/
.claude/settings.local.json
